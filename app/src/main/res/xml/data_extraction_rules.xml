<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted documents from cloud backup -->
        <exclude domain="file" path="encrypted_documents/"/>
        <exclude domain="file" path="encrypted_profiles/"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted documents from device transfer -->
        <exclude domain="file" path="encrypted_documents/"/>
        <exclude domain="file" path="encrypted_profiles/"/>
    </device-transfer>
</data-extraction-rules>